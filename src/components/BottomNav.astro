---
import type { Lang } from '@/i18n/locales';
import { t } from '@/i18n/t';
import { localeUrl } from '@/lib/urls';
interface Props {
  lang: Lang;
  current?: 'today' | 'program' | 'exercises' | 'more';
}
const { lang, current } = Astro.props;
const items = [
  { id: 'today', href: localeUrl(lang), label: t(lang, 'nav.today') },
  { id: 'program', href: localeUrl(lang, 'program'), label: t(lang, 'nav.program') },
  { id: 'exercises', href: localeUrl(lang, 'exercises'), label: t(lang, 'nav.exercises') },
  { id: 'more', href: localeUrl(lang, 'more'), label: t(lang, 'nav.more') },
] as const;
---

<nav class="bottom-nav" aria-label={t(lang, 'nav.primary')}>
  <ul>
    {items.map((it) => (
      <li>
        <a href={it.href} aria-current={current === it.id ? 'page' : undefined}>
          {it.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .bottom-nav {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    background: var(--surface);
    border-top: 1px solid var(--line);
    padding-bottom: env(safe-area-inset-bottom, 0px);
    z-index: 50;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-2);
    max-width: 880px;
    margin-inline: auto;
  }
  a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap);
    padding: var(--space-2);
    text-decoration: none;
    color: var(--muted);
    font-weight: 600;
    font-size: var(--fs-small);
    border-top: 3px solid transparent;
  }
  a[aria-current='page'] {
    color: var(--accent);
    border-top-color: var(--accent);
    font-weight: 700;
  }
  @media (min-width: 1100px) {
    ul {
      max-width: 1120px;
    }
  }
  @media (min-width: 900px) {
    .bottom-nav {
      position: sticky;
      top: 0;
      bottom: auto;
      border-top: 0;
      border-bottom: 1px solid var(--line);
    }
    a[aria-current='page'] {
      border-top-color: transparent;
      border-bottom: 3px solid var(--accent);
    }
  }
</style>
