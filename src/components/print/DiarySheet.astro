---
import { t } from '@/i18n/t';
import type { Lang } from '@/i18n/locales';
import { WEEKDAYS } from '@/content/schemas';
import { getProgram } from '@/lib/content';
import { findDay } from '@/lib/program';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const program = await getProgram(lang);
const days = WEEKDAYS.map((weekday) => findDay(program.data, weekday));
---

<div class="sheet">
  <h1>{t(lang, 'print.diary_title')}</h1>

  <p class="fields">
    {t(lang, 'print.week')} <span class="blank"></span>
    {t(lang, 'print.from')} <span class="blank"></span>
    {t(lang, 'print.to')} <span class="blank"></span>
  </p>

  <table>
    <colgroup>
      <col style="width: 16%" />
      <col style="width: 22%" />
      <col style="width: 10%" />
      <col style="width: 14%" />
      <col style="width: 16%" />
      <col style="width: 22%" />
    </colgroup>
    <thead>
      <tr>
        <th scope="col">{t(lang, 'table.day')}</th>
        <th scope="col">{t(lang, 'table.session')}</th>
        <th scope="col">{t(lang, 'print.date')}</th>
        <th scope="col">{t(lang, 'print.done')}</th>
        <th scope="col">{t(lang, 'print.feeling')}</th>
        <th scope="col">{t(lang, 'print.note')}</th>
      </tr>
    </thead>
    <tbody>
      {days.map((day) => (
        <tr>
          <th scope="row">{t(lang, `weekday.${day.weekday}`)}</th>
          <td>{day.title}</td>
          <td></td>
          <td>
            <span class="box"></span>
          </td>
          <td></td>
          <td></td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>{t(lang, 'print.daily')}</h2>
  {program.data.daily.map((item) => (
    <div class="daily-item">
      <p>{item.text}</p>
      <p class="week-boxes">
        {WEEKDAYS.map((weekday) => (
          <span class="day-box">
            {!item.exceptWeekdays.includes(weekday) && <span class="box"></span>}
            <span class="hint">{t(lang, `weekday.${weekday}`).slice(0, 2)}</span>
          </span>
        ))}
      </p>
    </div>
  ))}
</div>

<style>
  .sheet h1 {
    font-size: 17pt;
    margin: 0 0 2mm;
  }
  .sheet h2 {
    font-size: 12pt;
    margin: 6mm 0 2mm;
  }
  .sheet table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .sheet th,
  .sheet td {
    border: 1px solid #000;
    padding: 1.5mm 2mm;
    vertical-align: top;
    text-align: left;
    overflow-wrap: anywhere;
  }
  .sheet th {
    font-size: 9pt;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .sheet .hint {
    font-size: 9pt;
    color: #333;
  }
  .sheet .blank {
    display: inline-block;
    min-width: 28mm;
    border-bottom: 1px solid #000;
  }
  .sheet .box {
    display: inline-block;
    width: 6mm;
    height: 6mm;
    border: 1px solid #000;
    margin-right: 1.5mm;
  }
  @media screen and (max-width: 480px) {
    .sheet .blank {
      min-width: 10mm;
    }
    .sheet .box {
      width: 4mm;
      height: 4mm;
      margin-right: 1mm;
    }
  }
  .fields {
    margin: 0 0 3mm;
  }
  .daily-item p:first-child {
    margin: 0 0 1mm;
  }
  .week-boxes {
    display: flex;
    flex-wrap: wrap;
    gap: 3mm;
    margin: 0 0 3mm;
  }
  .day-box {
    display: inline-flex;
    align-items: center;
    gap: 1mm;
  }
</style>
