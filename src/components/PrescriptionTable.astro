---
import type { Lang } from '@/i18n/locales';
import { t } from '@/i18n/t';
import { PHASE_IDS, type PhaseId, type Prescription } from '@/content/schemas';
import { formatPrescription } from '@/lib/program';

interface Props {
  lang: Lang;
  prescriptions: Record<PhaseId, Prescription>;
}
const { lang, prescriptions } = Astro.props;

function loadAndNote(p: Prescription): string {
  return [p.load, p.note].filter(Boolean).join('. ');
}
---

<div
  class="table-wrap presc-narrow"
  tabindex="0"
  role="region"
  aria-label={t(lang, 'table.scroll_hint')}
>
  <table>
    <thead>
      <tr>
        <th scope="col">{t(lang, 'day.phase')}</th>
        <th scope="col">{t(lang, 'table.volume')}</th>
        <th scope="col">{t(lang, 'table.step_load')}</th>
      </tr>
    </thead>
    <tbody>
      {PHASE_IDS.map((phase) => {
        const p = prescriptions[phase];
        return (
          <tr data-phase={phase}>
            <th scope="row">{t(lang, `phase.${phase}`)}</th>
            <td class="num">{formatPrescription(p, lang)}</td>
            <td>
              {t(lang, `exercise.step.${p.step}`)}
              {p.load && <span class="load">, {p.load}</span>}
              {p.note && <span class="note-inline">. {p.note}</span>}
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>

<div
  class="table-wrap presc-wide"
  tabindex="0"
  role="region"
  aria-label={t(lang, 'table.scroll_hint')}
>
  <table>
    <thead>
      <tr>
        <th scope="col">{t(lang, 'day.phase')}</th>
        {PHASE_IDS.map((phase) => (
          <th scope="col">{t(lang, `phase.${phase}`)}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      <tr>
        <th scope="row">{t(lang, 'table.volume')}</th>
        {PHASE_IDS.map((phase) => (
          <td class="num" data-phase={phase}>
            {formatPrescription(prescriptions[phase], lang)}
          </td>
        ))}
      </tr>
      <tr>
        <th scope="row">{t(lang, 'table.step')}</th>
        {PHASE_IDS.map((phase) => (
          <td data-phase={phase}>{t(lang, `exercise.step.${prescriptions[phase].step}`)}</td>
        ))}
      </tr>
      <tr>
        <th scope="row">{t(lang, 'table.load_note')}</th>
        {PHASE_IDS.map((phase) => (
          <td data-phase={phase}>{loadAndNote(prescriptions[phase])}</td>
        ))}
      </tr>
    </tbody>
  </table>
</div>

<style>
  .num {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    font-weight: 700;
  }
  .presc-wide {
    display: none;
  }
  @media (min-width: 900px) {
    .presc-narrow {
      display: none;
    }
    .presc-wide {
      display: block;
    }
  }
</style>
