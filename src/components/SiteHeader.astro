---
import { BUILT_LOCALES, LOCALE_NAMES, type Lang } from '@/i18n/locales';
import { t } from '@/i18n/t';
import { localeUrl } from '@/lib/urls';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Та же страница на другом языке: меняется только первый сегмент после base.
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const rest = Astro.url.pathname.slice(base.length).split('/').slice(1).join('/');
// Порядок всегда один и тот же, русский первым: список не перестраивается
// в зависимости от того, на каком языке открыта страница.
const options = BUILT_LOCALES.map((l) => ({
  lang: l,
  name: LOCALE_NAMES[l],
  href: `${base}${l}/${rest}`,
  current: l === lang,
}));
---

<header class="site-header">
  <div class="container row">
    <a class="brand" href={localeUrl(lang)}>
      {t(lang, 'site.name')}
    </a>
    <p class="tagline">{t(lang, 'site.tagline')}</p>
    {options.length > 1 && (
      <details class="lang">
        <summary aria-label={t(lang, 'nav.language')}>{LOCALE_NAMES[lang]}</summary>
        <ul>
          {options.map((o) => (
            <li>
              <a
                href={o.href}
                hreflang={o.lang}
                lang={o.lang}
                data-lang={o.lang}
                aria-current={o.current ? 'page' : undefined}
              >
                {o.name}
              </a>
            </li>
          ))}
        </ul>
      </details>
    )}
  </div>
</header>

<script is:inline>
  // Выбор запоминается, чтобы корень сайта больше не подставлял язык системы.
  document.querySelectorAll('.lang a[data-lang]').forEach((a) => {
    a.addEventListener('click', () => {
      try {
        localStorage.setItem('steadya.lang', a.dataset.lang);
      } catch {
        /* приватный режим: выбор просто не запомнится */
      }
    });
  });
  // Список закрывается кликом мимо и клавишей Escape, как обычное меню.
  document.addEventListener('click', (e) => {
    document.querySelectorAll('details.lang[open]').forEach((d) => {
      if (!d.contains(e.target)) d.removeAttribute('open');
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    document.querySelectorAll('details.lang[open]').forEach((d) => {
      d.removeAttribute('open');
      d.querySelector('summary').focus();
    });
  });
</script>

<style>
  .site-header {
    /* выше полосы навигации (z-index 50), иначе она перекрывает список языков */
    position: relative;
    z-index: 60;
    border-bottom: 2px solid var(--accent);
    background: var(--surface);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    min-height: var(--tap);
    padding-block: var(--space-2);
  }
  .brand {
    font-family: var(--font-display);
    font-size: var(--fs-1);
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
  }
  .lang {
    margin-inline-start: auto;
    position: relative;
    font-size: var(--fs-small);
  }
  .lang summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    padding-inline: var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--ink);
  }
  .lang summary::-webkit-details-marker {
    display: none;
  }
  /* стрелка вниз, поворачивается, пока список открыт */
  .lang summary::after {
    content: '';
    width: 0.45em;
    height: 0.45em;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-25%) rotate(45deg);
    transition: transform 0.15s;
  }
  .lang[open] summary::after {
    transform: translateY(25%) rotate(-135deg);
  }
  .lang summary:hover {
    background: var(--accent-soft);
  }
  .lang ul {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + var(--space-1));
    margin: 0;
    padding: var(--space-1);
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.14);
    min-width: 11rem;
  }
  .lang a {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: var(--space-3);
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
  }
  .lang a:hover {
    background: var(--accent-soft);
  }
  .lang a[aria-current='page'] {
    font-weight: 700;
    color: var(--accent);
  }
  .lang a[aria-current='page']::after {
    content: '✓';
    margin-inline-start: auto;
  }
  .tagline {
    margin: 0;
    color: var(--muted);
    font-size: var(--fs-small);
  }
</style>
