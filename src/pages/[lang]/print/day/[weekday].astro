---
import PrintLayout from '@/layouts/PrintLayout.astro';
import { BUILT_LOCALES, type Lang } from '@/i18n/locales';
import { t } from '@/i18n/t';
import {
  isExerciseItem,
  PHASE_IDS,
  WEEKDAYS,
  type Prescription,
  type Weekday,
} from '@/content/schemas';
import { getExercisesByLang, getProgram } from '@/lib/content';
import { findDay, formatPrescription } from '@/lib/program';

export async function getStaticPaths() {
  const paths: { params: { lang: Lang; weekday: Weekday } }[] = [];
  for (const lang of BUILT_LOCALES) {
    const program = await getProgram(lang);
    for (const weekday of WEEKDAYS) {
      const day = findDay(program.data, weekday);
      if (day.blocks.length > 0) paths.push({ params: { lang, weekday } });
    }
  }
  return paths;
}

const lang = Astro.params.lang as Lang;
const weekday = Astro.params.weekday as Weekday;
const program = await getProgram(lang);
const day = findDay(program.data, weekday);
const all = await getExercisesByLang(lang);
const exercises = new Map(all.map((e) => [e.data.slug, e]));

function weeksLabel(phaseId: (typeof PHASE_IDS)[number]): string {
  const phase = program.data.phases.find((p) => p.id === phaseId);
  if (!phase) throw new Error(`phase ${phaseId} missing`);
  return `${phase.weeks[0]}–${phase.weeks[1]}`;
}

function details(p: Prescription): string {
  return [t(lang, `exercise.step.${p.step}`), p.load, p.note].filter(Boolean).join(', ');
}

function planLine(p: Prescription, phaseId: (typeof PHASE_IDS)[number]): string {
  const d = details(p);
  const volume = formatPrescription(p, lang);
  return d ? `${weeksLabel(phaseId)}: ${volume}, ${d}` : `${weeksLabel(phaseId)}: ${volume}`;
}

const rows = day.blocks.flatMap((block) =>
  block.items.filter(isExerciseItem).map((item) => {
    const exercise = exercises.get(item.exercise);
    if (!exercise) throw new Error(`exercise ${item.exercise} missing in map`);
    const maxSets = Math.max(3, ...PHASE_IDS.map((p) => item.prescriptions[p]?.sets ?? 0));
    return { exercise, item, maxSets };
  }),
);

const title = t(lang, 'print.day_title', {
  weekday: t(lang, `weekday.${weekday}`),
  title: day.title,
});
---

<PrintLayout lang={lang} title={title}>
  <div class="head-line">
    <h1>{title}</h1>
    {day.durationMin > 0 && <span>{t(lang, 'day.duration', { min: day.durationMin })}</span>}
  </div>

  <p class="fields">
    {t(lang, 'print.date')} <span class="blank"></span>
    {t(lang, 'print.week')} <span class="blank"></span>
    {t(lang, 'print.phase')} <span class="blank"></span>
  </p>

  <h2>{t(lang, 'day.warmup')}</h2>
  <ul class="routine hint">
    {program.data.warmup.map((step) => (
      <li>{step.text}</li>
    ))}
  </ul>

  <table>
    <colgroup>
      <col style="width: 28%" />
      <col style="width: 36%" />
      <col style="width: 12%" />
      <col style="width: 12%" />
      <col style="width: 12%" />
    </colgroup>
    <thead>
      <tr>
        <th scope="col">{t(lang, 'print.exercise')}</th>
        <th scope="col">{t(lang, 'print.plan')}</th>
        <th scope="col">{t(lang, 'print.sets')}</th>
        <th scope="col">{t(lang, 'print.load')}</th>
        <th scope="col">{t(lang, 'print.reps')}</th>
      </tr>
    </thead>
    <tbody>
      {rows.map(({ exercise, item, maxSets }) => (
        <tr>
          <td>{exercise.data.title}</td>
          <td class="plan hint">
            {PHASE_IDS.map((phase) => (
              <div>{planLine(item.prescriptions[phase], phase)}</div>
            ))}
          </td>
          <td>
            {Array.from({ length: maxSets }).map(() => (
              <span class="box"></span>
            ))}
          </td>
          <td></td>
          <td></td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>{t(lang, 'day.cooldown')}</h2>
  <ul class="routine hint">
    {program.data.cooldown.map((step) => (
      <li>{step.text}</li>
    ))}
  </ul>

  <p class="fields">
    {t(lang, 'print.feeling')} <span class="blank"></span>
    {t(lang, 'print.note')} <span class="blank blank-wide"></span>
  </p>
</PrintLayout>

<style>
  .head-line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 4mm;
  }
  .head-line h1 {
    margin: 0;
  }
  .fields {
    margin: 0 0 0.5mm;
  }
  h2 {
    margin: 2mm 0 1mm;
  }
  .routine {
    margin: 0 0 1mm;
    padding-inline-start: 5mm;
    line-height: 1.15;
  }
  .routine li {
    margin-bottom: 0.25mm;
  }
  table th,
  table td {
    padding: 0.25mm 2mm;
  }
  .plan {
    font-size: 8pt;
    line-height: 1;
  }
  :global(.disclaimer) {
    margin-top: 1mm;
    line-height: 1.1;
  }
</style>
