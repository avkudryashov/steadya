---
import PrintLayout from '@/layouts/PrintLayout.astro';
import DaySheet from '@/components/print/DaySheet.astro';
import { BUILT_LOCALES, type Lang } from '@/i18n/locales';
import { t } from '@/i18n/t';
import { WEEKDAYS, type Weekday } from '@/content/schemas';
import { getProgram } from '@/lib/content';
import { findDay } from '@/lib/program';

export async function getStaticPaths() {
  const paths: { params: { lang: Lang; weekday: Weekday } }[] = [];
  for (const lang of BUILT_LOCALES) {
    const program = await getProgram(lang);
    for (const weekday of WEEKDAYS) {
      const day = findDay(program.data, weekday);
      if (day.blocks.length > 0) paths.push({ params: { lang, weekday } });
    }
  }
  return paths;
}

const lang = Astro.params.lang as Lang;
const weekday = Astro.params.weekday as Weekday;
const program = await getProgram(lang);
const day = findDay(program.data, weekday);
const title = t(lang, 'print.day_title', {
  weekday: t(lang, `weekday.${weekday}`),
  title: day.title,
});
---

<PrintLayout lang={lang} title={title}>
  <DaySheet lang={lang} weekday={weekday} />
</PrintLayout>

<style>
  :global(.disclaimer) {
    margin-top: 1mm;
    line-height: 1.1;
  }
</style>
