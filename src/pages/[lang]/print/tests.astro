---
import PrintLayout from '@/layouts/PrintLayout.astro';
import { BUILT_LOCALES, type Lang } from '@/i18n/locales';
import { t } from '@/i18n/t';
import { getTests } from '@/lib/content';

export function getStaticPaths() {
  return BUILT_LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const tests = await getTests(lang);
const measures = [1, 2, 3, 4];
---

<PrintLayout lang={lang} title={t(lang, 'print.tests_title')}>
  <h1>{t(lang, 'print.tests_title')}</h1>

  <table>
    <colgroup>
      <col style="width: 26%" />
      <col style="width: 22%" />
      <col style="width: 13%" />
      <col style="width: 13%" />
      <col style="width: 13%" />
      <col style="width: 13%" />
    </colgroup>
    <thead>
      <tr>
        <th scope="col">{t(lang, 'print.test')}</th>
        <th scope="col">{t(lang, 'tests.threshold')}</th>
        {measures.map((n) => (
          <th scope="col">
            {t(lang, 'print.measure', { n })}
            <br />
            <span class="blank"></span>
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {tests.map((test) => (
        <tr>
          <td>
            {test.title} <span class="hint">({test.howTo})</span>
          </td>
          <td>{test.thresholdNote}</td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
        </tr>
      ))}
    </tbody>
  </table>

  <p class="goal">{t(lang, 'tests.goal')}</p>
</PrintLayout>

<style>
  .goal {
    margin-top: 4mm;
  }
</style>
