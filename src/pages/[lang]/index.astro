---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TodayCard from '@/islands/TodayCard';
import { WEEKDAYS, type Weekday } from '@/content/schemas';
import { BUILT_LOCALES, type Lang } from '@/i18n/locales';
import { t } from '@/i18n/t';
import { getProgram } from '@/lib/content';
import { localeUrl } from '@/lib/urls';

export function getStaticPaths() {
  return BUILT_LOCALES.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const program = await getProgram(lang);
const dayLinks = Object.fromEntries(
  WEEKDAYS.map((w) => [w, localeUrl(lang, `day/${w}`)]),
) as Record<Weekday, string>;
const sessionLinks = Object.fromEntries(
  WEEKDAYS.map((w) => [w, localeUrl(lang, `day/${w}/session`)]),
) as Record<Weekday, string>;
const meta = {
  id: program.data.id,
  weeks: program.data.weeks,
  deloadWeeks: program.data.deloadWeeks,
  phases: program.data.phases,
};
const days = program.data.days.map((d) => ({
  weekday: d.weekday,
  title: d.title,
  durationMin: d.durationMin,
  kind: d.kind,
  hasBlocks: d.blocks.length > 0,
}));
---

<BaseLayout
  lang={lang}
  title={t(lang, 'home.title')}
  description={t(lang, 'home.lead')}
  current="today"
>
  <h1>{t(lang, 'home.title')}</h1>
  <p>{t(lang, 'home.lead')}</p>
  <p class="note warn">
    {t(lang, 'site.disclaimer')} <a href={localeUrl(lang, 'safety')}>{t(lang, 'more.safety')}</a>
  </p>
  <TodayCard
    client:load
    lang={lang}
    program={meta}
    days={days}
    dayLinks={dayLinks}
    sessionLinks={sessionLinks}
    settingsLink={localeUrl(lang, 'settings')}
  />
  <ol class="week">
    {program.data.days.map((d) => (
      <li class={`card day day--${d.kind}`}>
        <p class="weekday">{t(lang, `weekday.${d.weekday}`)}</p>
        <h2>{d.title}</h2>
        {d.durationMin > 0 && <p class="dur">{t(lang, 'day.duration', { min: d.durationMin })}</p>}
        <a class="btn" href={localeUrl(lang, `day/${d.weekday}`)}>
          {t(lang, 'home.open_day')}
        </a>
      </li>
    ))}
  </ol>
  <section class="card">
    <h2>{t(lang, 'day.daily')}</h2>
    <ul class="measure">
      {program.data.daily.map((d) => (
        <li>{d.text}</li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style is:global>
  .today {
    margin-bottom: var(--space-6);
  }
  .today-day {
    font-family: var(--font-display);
    font-size: var(--fs-2);
    margin: 0 0 var(--space-1);
  }
  .today-meta {
    color: var(--muted);
    margin: 0 0 var(--space-3);
  }
  .today-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
  }
</style>

<style>
  .week {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  @media (min-width: 700px) {
    .week {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .day h2 {
    font-size: var(--fs-1);
  }
  .weekday {
    margin: 0;
    color: var(--accent);
    font-weight: 700;
    text-transform: uppercase;
    font-size: var(--fs-small);
    letter-spacing: 0.04em;
  }
  .dur {
    color: var(--muted);
  }
  .day--rest,
  .day--walk,
  .day--optional {
    background: transparent;
  }
</style>
