---
import { Picture } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { BUILT_LOCALES, type Lang } from '@/i18n/locales';
import { t } from '@/i18n/t';
import { getTests } from '@/lib/content';
import { pdfUrl } from '@/lib/urls';

export function getStaticPaths() {
  return BUILT_LOCALES.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tests = await getTests(lang);
const measures = [1, 2, 3, 4];
---

<BaseLayout
  lang={lang}
  title={t(lang, 'tests.title')}
  description={t(lang, 'tests.lead')}
  current="more"
>
  <h1>{t(lang, 'tests.title')}</h1>
  <p>{t(lang, 'tests.lead')}</p>
  <div class="list">
    {tests.map((test) => (
      <article class="card test" id={test.id}>
        <div class="media">
          <Picture
            src={test.image}
            alt={test.imageAlt}
            widths={[320, 640, 960]}
            sizes="(max-width: 900px) 100vw, 320px"
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="body">
          <h2>{test.title}</h2>
          <p>
            <strong>{t(lang, 'tests.how')}:</strong> {test.howTo}
          </p>
          <p>
            <strong>{t(lang, 'tests.threshold')}:</strong> {test.thresholdNote}
          </p>
          {test.thresholdsByAge && (
            <ul class="bands">
              {test.thresholdsByAge.map((band) => (
                <li class="band">
                  <span class="band-ages">{band.ages}</span>
                  <span class="band-value">{band.value}</span>
                </li>
              ))}
            </ul>
          )}
          <p>
            <strong>{t(lang, 'tests.meaning')}:</strong> {test.meaning}
          </p>
          <p class="print-only measures">
            {measures.map((n) => (
              <span class="measure-slot">
                {t(lang, 'print.measure', { n })} <span class="blank"></span>
              </span>
            ))}
          </p>
        </div>
      </article>
    ))}
  </div>
  <p>{t(lang, 'tests.goal')}</p>
  <p class="measure">
    {t(lang, 'tests.norms_source')}{' '}
    <a href="https://pubmed.ncbi.nlm.nih.gov/22613940/">{t(lang, 'tests.norms_link')}</a>
  </p>
  <p>
    <button class="btn secondary" type="button" onclick="window.print()">
      {t(lang, 'print.tests_sheet')}
    </button>
    <a class="btn secondary" href={pdfUrl(lang, 'tests')} download>
      {t(lang, 'print.pdf_tests')}
    </a>
  </p>
</BaseLayout>

<style>
  .list {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .test {
    display: grid;
    gap: var(--space-4);
    max-width: none;
  }
  .body {
    min-width: 0;
  }
  .body :global(h2) {
    margin-top: 0;
  }
  .media :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: var(--image-bg);
    border-radius: var(--radius);
  }
  @media (min-width: 900px) {
    .test {
      grid-template-columns: 280px minmax(0, 1fr);
      align-items: start;
    }
  }
  @media (min-width: 1100px) {
    .test {
      grid-template-columns: 320px minmax(0, 1fr);
    }
  }
  @media print {
    .test {
      grid-template-columns: 76mm minmax(0, 1fr);
      align-items: start;
      gap: 6mm;
      break-before: page;
    }
  }
  .bands {
    list-style: none;
    margin: 0 0 var(--space-3);
    padding: 0;
    max-width: none;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) max-content;
    gap: var(--space-3);
    padding: var(--space-1) var(--space-3);
    border-top: 1px solid var(--line);
  }
  .band:first-child {
    border-top: 0;
  }
  .band-ages {
    color: var(--muted);
    font-size: var(--fs-small);
  }
  .band-value {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  @media print {
    .bands,
    .band {
      break-inside: avoid;
    }
  }
  .measures {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-2) 0 0;
  }
  .measure-slot {
    white-space: nowrap;
  }
</style>
