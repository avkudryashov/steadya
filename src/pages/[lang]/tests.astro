---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { BUILT_LOCALES, type Lang } from '@/i18n/locales';
import { t } from '@/i18n/t';
import { getTests } from '@/lib/content';
import { pdfUrl } from '@/lib/urls';

export function getStaticPaths() {
  return BUILT_LOCALES.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tests = await getTests(lang);
const measures = [1, 2, 3, 4];
---

<BaseLayout
  lang={lang}
  title={t(lang, 'tests.title')}
  description={t(lang, 'tests.lead')}
  current="more"
>
  <h1>{t(lang, 'tests.title')}</h1>
  <p>{t(lang, 'tests.lead')}</p>
  <div class="list">
    {tests.map((test) => (
      <article class="card" id={test.id}>
        <h2>{test.title}</h2>
        <p>
          <strong>{t(lang, 'tests.how')}:</strong> {test.howTo}
        </p>
        <p>
          <strong>{t(lang, 'tests.threshold')}:</strong> {test.thresholdNote}
        </p>
        <p>
          <strong>{t(lang, 'tests.meaning')}:</strong> {test.meaning}
        </p>
        <p class="print-only measures">
          {measures.map((n) => (
            <span class="measure">
              {t(lang, 'print.measure', { n })} <span class="blank"></span>
            </span>
          ))}
        </p>
      </article>
    ))}
  </div>
  <p>{t(lang, 'tests.goal')}</p>
  <p>
    <button class="btn secondary" type="button" onclick="window.print()">
      {t(lang, 'print.tests_sheet')}
    </button>
    <a class="btn secondary" href={pdfUrl(lang, 'tests')} download>
      {t(lang, 'print.pdf_tests')}
    </a>
  </p>
</BaseLayout>

<style>
  .list {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .measures {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-2) 0 0;
  }
  .measure {
    white-space: nowrap;
  }
</style>
