---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ExerciseCard from '@/components/ExerciseCard.astro';
import AtlasFilter from '@/islands/AtlasFilter';
import { BUILT_LOCALES, type Lang } from '@/i18n/locales';
import { t } from '@/i18n/t';
import { CATEGORIES, EQUIPMENT } from '@/content/schemas';
import { getExercisesByLang } from '@/lib/content';

export function getStaticPaths() {
  return BUILT_LOCALES.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const exercises = await getExercisesByLang(lang);
const groups = CATEGORIES.map((c) => ({
  c,
  items: exercises.filter((e) => e.data.category === c),
})).filter((g) => g.items.length);
const equipment = EQUIPMENT.filter((id) =>
  exercises.some((e) => e.data.equipment.includes(id)),
).map((id) => ({ id, label: t(lang, `equipment.${id}`) }));
---

<BaseLayout
  lang={lang}
  title={t(lang, 'exercises.title')}
  description={t(lang, 'exercises.lead')}
  current="exercises"
>
  <h1>{t(lang, 'exercises.title')}</h1>
  <p>{t(lang, 'exercises.lead')}</p>
  <nav aria-label={t(lang, 'exercises.categories')} class="chips">
    {groups.map((g) => (
      <a class="chip" href={`#cat-${g.c}`}>
        {t(lang, `category.${g.c}`)} ({g.items.length})
      </a>
    ))}
  </nav>
  <AtlasFilter client:load lang={lang} equipment={equipment} />
  <div data-atlas>
    {groups.map((g) => (
      <section aria-labelledby={`cat-${g.c}`}>
        <h2 id={`cat-${g.c}`}>{t(lang, `category.${g.c}`)}</h2>
        <div class="grid">
          {g.items.map((e) => (
            <ExerciseCard lang={lang} exercise={e} variant="compact" />
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--space-4);
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--ink);
    border: 2px solid var(--accent);
    text-decoration: none;
    font-weight: 600;
  }
</style>

<style is:global>
  .atlas-filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }
  .atlas-filter button {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--space-4);
    border-radius: 999px;
    border: 2px solid transparent;
    background: var(--accent-soft);
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .atlas-filter button[aria-pressed='true'] {
    border-color: var(--accent);
  }
</style>
