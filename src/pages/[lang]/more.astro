---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { BUILT_LOCALES, type Lang } from '@/i18n/locales';
import { t } from '@/i18n/t';
import { WEEKDAYS } from '@/content/schemas';
import { getPagesByLang, getProgram } from '@/lib/content';
import { findDay } from '@/lib/program';
import { localeUrl, pdfUrl } from '@/lib/urls';

export function getStaticPaths() {
  return BUILT_LOCALES.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const pages = await getPagesByLang(lang);
const links = [
  { href: localeUrl(lang, 'tests'), label: t(lang, 'more.tests') },
  ...pages.map((p) => ({ href: localeUrl(lang, p.id.split('/')[1]!), label: p.data.title })),
];
const program = await getProgram(lang);
const printableWeekdays = WEEKDAYS.filter(
  (weekday) => findDay(program.data, weekday).blocks.length > 0,
);
const printLinks = [
  { href: localeUrl(lang, 'print/diary'), label: t(lang, 'print.diary_sheet') },
  { href: localeUrl(lang, 'print/tests'), label: t(lang, 'print.tests_sheet') },
  ...printableWeekdays.map((weekday) => ({
    href: localeUrl(lang, `print/day/${weekday}`),
    label: `${t(lang, `weekday.${weekday}`)}. ${t(lang, 'print.day_sheet')}`,
  })),
];
const pdfLinks = [
  ...printableWeekdays.map((weekday) => ({
    href: pdfUrl(lang, `day-${weekday}`),
    label: `${t(lang, `weekday.${weekday}`)}. ${t(lang, 'print.pdf_day')}`,
  })),
  { href: pdfUrl(lang, 'diary'), label: t(lang, 'print.pdf_diary') },
  { href: pdfUrl(lang, 'tests'), label: t(lang, 'print.pdf_tests') },
  { href: pdfUrl(lang, 'program'), label: t(lang, 'print.pdf_all') },
];
---

<BaseLayout
  lang={lang}
  title={t(lang, 'nav.more')}
  description={t(lang, 'site.tagline')}
  current="more"
>
  <h1>{t(lang, 'nav.more')}</h1>
  <ul class="links">
    {links.map((l) => (
      <li>
        <a class="row" href={l.href}>
          {l.label}
        </a>
      </li>
    ))}
  </ul>

  <h2>{t(lang, 'print.section')}</h2>
  <ul class="links">
    {printLinks.map((l) => (
      <li>
        <a class="row" href={l.href}>
          {l.label}
        </a>
      </li>
    ))}
  </ul>

  <h2>{t(lang, 'print.pdf_section')}</h2>
  <ul class="links">
    {pdfLinks.map((l) => (
      <li>
        <a class="row" href={l.href} download>
          {l.label}
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .links {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .row {
    display: flex;
    align-items: center;
    min-height: calc(var(--tap) + var(--space-2));
    padding: 0 var(--space-4);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    text-decoration: none;
    font-weight: 600;
    color: var(--ink);
  }
</style>
