---
import { getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SessionRunner from '@/islands/SessionRunner';
import { BUILT_LOCALES, type Lang } from '@/i18n/locales';
import { t } from '@/i18n/t';
import { isExerciseItem, WEEKDAYS, type Weekday } from '@/content/schemas';
import { getExercisesByLang, getProgram } from '@/lib/content';
import { findDay } from '@/lib/program';
import { localeUrl } from '@/lib/urls';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of BUILT_LOCALES) {
    const program = await getProgram(lang);
    for (const weekday of WEEKDAYS) {
      const day = findDay(program.data, weekday);
      if (day.blocks.length === 0) continue;
      paths.push({ params: { lang, weekday } });
    }
  }
  return paths;
}

const lang = Astro.params.lang as Lang;
const weekday = Astro.params.weekday as Weekday;
const program = await getProgram(lang);
const day = findDay(program.data, weekday);
const exercises = new Map((await getExercisesByLang(lang)).map((e) => [e.data.slug, e]));

const steps = [];
for (const block of day.blocks) {
  for (const item of block.items) {
    if (!isExerciseItem(item)) continue;
    const entry = exercises.get(item.exercise);
    if (!entry) throw new Error(`no exercise ${item.exercise} for ${lang}`);
    const picture = await getImage({ src: entry.data.image, width: 640, format: 'webp' });
    steps.push({
      exerciseId: entry.data.slug,
      title: entry.data.title,
      imageSrc: picture.src,
      imageAlt: entry.data.imageAlt,
      cue: entry.data.shortCue,
      technique: entry.data.technique,
      stopSigns: entry.data.stopSigns,
      prescriptions: item.prescriptions,
    });
  }
}
---

<BaseLayout
  lang={lang}
  title={`${t(lang, 'session.title')}: ${day.title}`}
  description={day.title}
  current="today"
  noindex
>
  <p class="note">{t(lang, 'session.keep_awake')}</p>
  <SessionRunner
    client:load
    lang={lang}
    weekday={weekday}
    program={{
      id: program.data.id,
      weeks: program.data.weeks,
      deloadWeeks: program.data.deloadWeeks,
      phases: program.data.phases,
    }}
    steps={steps}
    dayLink={localeUrl(lang, `day/${weekday}`)}
  />
</BaseLayout>

<style is:global>
  .runner img {
    width: 100%;
    max-width: 420px;
    border-radius: var(--radius);
    background: var(--image-bg);
  }
  .runner-progress {
    color: var(--muted);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: var(--fs-small);
    margin: 0;
  }
  .runner-prescription {
    font-size: var(--fs-1);
    font-weight: 700;
  }
  .runner-set {
    font-size: var(--fs-1);
  }
  .runner-inputs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(12rem, 100%), 1fr));
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .runner-inputs label {
    display: grid;
    gap: var(--space-1);
    font-size: var(--fs-small);
    color: var(--muted);
  }
  .runner-inputs input {
    min-height: var(--tap);
    font: inherit;
    padding: 0 var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
  }
  .runner-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .runner-stop summary {
    min-height: var(--tap);
    display: flex;
    align-items: center;
    cursor: pointer;
    font-weight: 700;
    color: var(--accent);
  }
  .rest {
    text-align: center;
    padding: var(--space-4);
    background: var(--accent-soft);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-4);
  }
  .rest-value {
    font-size: 4rem;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    margin: 0 0 var(--space-3);
    line-height: 1;
  }
</style>
